{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(.venv/bin/pytest:*)", "Bash(.venv/bin/ruff:*)", "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip install:*)", "Bash(node:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git show:*)", "Bash(git branch:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(mkdir:*)", "Bash(touch:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(grep:*)", "Bash(find:*)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(git reset:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
      "Bash(git rebase:*)", "Bash(git merge:*)", "Bash(git worktree:*)", "Bash(git stash:*)",
      "Bash(rm:*)", "Bash(sudo:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(gh:*)",
      "Bash(launchctl:*)", "Bash(pmset:*)",
      "Read(.env)", "Read(**/.env)", "Edit(.env)", "Write(.env)",
      "WebFetch", "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/automation/hooks/protect.sh" }
        ]
      }
    ]
  }
}
